{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=MiniBankingDB;User Id=minibank_user;Password=StrongPassword@123;TrustServerCertificate=True"
  },
  "Jwt": {
    "Key": "This-Is-A-Secret-Key-For-Jwt-Dont-Share",
    "Issuer": "MiniBank",
    "Audience": "MiniBankUsers",
    "ExpireMinutes": 60
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  }
}
